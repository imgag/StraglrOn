{
    "version": "0.2.0",
    "configurations": [        
        {
            "name": "Debug with testdata",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/straglron.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/testdata/24056LRa008_01_repeats.bed",
                "${workspaceFolder}/testdata/24056LRa008_01_repeats.tsv",
                "${workspaceFolder}/testdata/straglr_variant_catalog_grch38.bed",
                "--hist", 
                "-o", "${workspaceFolder}/out",
                "--bam", "${workspaceFolder}/testdata/24056LRa008_01.bam",
                "--genome", "${workspaceFolder}/testdata/GRCh38.fa",
                "--alleles",
                "--flank", "25"
            ]
        }
    ]
}